  "annotation": {
    "version": 1,
    "task": "Make sure glosses are never lost: carry them onto commits made by squashes, cherry-picks and rebases (locally and on GitHub), and keep every replaced or dropped gloss recoverable",
    "summary": "A line-level merge (merge.ts) builds a commit's gloss from the glosses of the commits its changes came from; `git gloss carry` exposes it. Hooks use it: post-rewrite combines glosses on squash/fixup and re-glosses rewrites that changed a diff; post-commit carries cherry-picks and default-message squash merges. `sync` (so every push) finds unglossed commits made by server-side squash or rebase merges and carries onto them. `git gloss versions` lists and restores every past gloss from the notes history, and glossed wip snapshots are archived so git gc keeps their diffs.",
    "groups": [
      {
        "id": "merge",
        "intent": "Build one gloss for a commit from several source glosses, line by line",
        "necessity": "required",
        "serves": "task",
        "removal_impact": "nothing could move a gloss onto a squash, cherry-pick or changed rewrite; every other group depends on it",
        "evidence": "test/carry.test.ts: squash of three commits, gaps, cherry-pick onto a moved base, repeated lines, renames, a stale source note",
        "hunks": [
          "h26"
        ],
        "notes": "Source hunks are resolved by content with matchHunks; a hunk whose changes differ from what was glossed is skipped and reported (git-gud's review found that reading ids by position credited the wrong file). Added lines go to the latest source with that text, removed lines to the earliest; a line several groups wrote takes its nearest uniquely matched neighbour's group. Source lines follow later renames, including header-only (binary) hunks. Clashing ids get the source's position appended. Unmatched lines are gaps, never guessed."
      },
      {
        "id": "carry-cmd",
        "intent": "`git gloss carry <source>... [--to <commit>] [--force]`",
        "necessity": "required",
        "serves": "task",
        "removal_impact": "a missing gloss after a squash or cherry-pick could only be fixed by re-glossing by hand",
        "hunks": [
          "h14:1,3,6-76,111-117,122-123,148-158"
        ],
        "notes": "Replaces an unreadable note (the joined notes a local squash leaves) and an earlier carried gloss, as add does; a hand-written gloss needs --force. Names sources whose gloss can't be read and hunks skipped as stale, so their lines aren't reported as never glossed."
      },
      {
        "id": "find-origins",
        "intent": "Work out which glossed commits a commit's changes came from",
        "necessity": "required",
        "serves": "task",
        "removal_impact": "the hooks and sync couldn't carry glosses without being told the sources, so cherry-picks and GitHub merges would stay unglossed",
        "evidence": "Tests: cherry-pick with and without -x, a default-message squash merge, a squash with its own message (--squash), a server-style rebase (new committer, same author date)",
        "hunks": [
          "h27:2-118",
          "h23",
          "h25"
        ],
        "notes": "Three tiers, cheapest first: the commit message (cherry-pick -x trailer, git's 'Squashed commit of the following' list); a glossed commit with the same author, author date and patch-id; with --squash, the unmerged branch whose combined diff shares at least 80% of changed lines with the commit, measured against the larger of the two. git-gud's review showed the first version (branch glosses explain half the commit's lines) glossing an unrelated three-line commit; the symmetric measure rejects it (tested). diffBetween and the EMPTY_TREE export in git.ts serve it. Glossed commits not present locally are ignored."
      },
      {
        "id": "hook-modes",
        "intent": "carry --rewritten (post-rewrite) and --find (post-commit), quiet for hooks",
        "necessity": "required",
        "serves": "hooks",
        "removal_impact": "the hooks would have no entry point to call",
        "hunks": [
          "h14:2,4-5,77-110,118-121,124-147"
        ],
        "notes": "--rewritten groups git's old->new list by new commit: several olds are always combined; a single old is re-carried only if the new commit has no gloss, an unreadable one, or one whose hunks no longer match. Amend reports during a rebase are ignored; the rebase's own report covers them (observed: git reports temporary amends for each squash step)."
      },
      {
        "id": "hooks",
        "intent": "Install post-rewrite; post-commit also carries cherry-picks and squash merges",
        "necessity": "required",
        "serves": "task",
        "removal_impact": "local squashes would leave joined, unreadable notes and cherry-picks would lose their gloss unless the user ran carry by hand",
        "evidence": "Hook tests: rebase with fixup and squash, amend changing the diff, message-only amend, cherry-pick; existing hook tests updated for the new post-rewrite hook",
        "hunks": [
          "h15",
          "h16"
        ],
        "notes": "post-commit only starts git-gloss when a wip snapshot exists or the reflog says cherry-pick / default squash message, so ordinary commits stay cheap. Repos need `git gloss init --hooks` re-run to get them. init's closing note now explains server-side squashes instead of saying they drop notes."
      },
      {
        "id": "sync-discovery",
        "intent": "sync (and every push) carries glosses onto squash and rebase merges",
        "necessity": "required",
        "serves": "task",
        "removal_impact": "GitHub's 'Squash and merge' and 'Rebase and merge' commits would have no gloss on main",
        "evidence": "Test: a branch squashed and deleted on the server is glossed by the next sync and pushed; a second sync carries nothing",
