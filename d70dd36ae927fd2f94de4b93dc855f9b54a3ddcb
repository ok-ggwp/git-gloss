    "task": "Structured review findings: reports end with a gloss-findings block, recorded as items; decisions name item ids; --open gate",
    "summary": "Pivot from heuristic finding labels to a validated block. --record refuses reports without it.",
    "groups": [
      {
        "id": "block-parser",
        "intent": "Parse and validate the gloss-findings block of a report",
        "necessity": "required",
        "serves": "task",
        "removal_impact": "Reports have no machine-readable findings, so nothing can be counted open or decided by id.",
        "impact": "contract",
        "hunks": [
          "h22"
        ],
        "notes": "Last backtick fence outside any other fence wins (CommonMark-style tracking); all-or-nothing validation with caps (200 items, 256 KiB, id pattern, enums) and plain() on text. BLOCK_SPEC is the text reviewers are told."
      },
      {
        "id": "record-gate",
        "intent": "--record refuses a report without a valid block and stores items",
        "necessity": "required",
        "serves": "task",
        "removal_impact": "A report with a missing or invalid block would be recorded and its findings could never be decided.",
        "impact": "contract",
        "hunks": [
          "h16"
        ],
        "notes": "Non-zero exit, every problem plus the spec on stderr, checked before any write. A report over 256 KiB (raw text, escapes count) is refused with a message that names the report including its block."
      },
